# Supabase — obtén estas keys en app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Stripe — obtén estas keys en dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — créalos en Stripe Dashboard → Products
STRIPE_PRICE_ESSENTIAL=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ELITE=price_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Black Label Market

# WhatsApp Business del negocio (numero en formato E.164 sin '+', ej. 34600000000)
# Vacio = el boton de WhatsApp de /contacto no se muestra. Diseno: black-series-core/agency/comercial/whatsapp_business_diseno.md
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase CLI — genera en: supabase.com/dashboard/account/tokens
# Necesario para migraciones automáticas (Vercel prebuild + GitHub Actions)
SUPABASE_ACCESS_TOKEN=sbp_...

# Bulk import — genera un secreto aleatorio: openssl rand -hex 32
# Úsalo en n8n como "Authorization: Bearer {valor}"
IMPORT_API_KEY=cambia_esto_por_un_secreto_seguro

# n8n webhooks — copia la URL del trigger "Webhook" de cada workflow en n8n
N8N_WEBHOOK_DEALER_SIGNUP=https://tu-n8n.com/webhook/dealer-signup
N8N_WEBHOOK_DEALER_SIGNUP_SECRET=
N8N_WEBHOOK_DEALER_APPROVED=https://tu-n8n.com/webhook/dealer-approved
N8N_WEBHOOK_DEALER_PENDING_INFO=https://tu-n8n.com/webhook/blm/dealer-pending-info
N8N_WEBHOOK_DEALER_REJECTED=https://tu-n8n.com/webhook/blm/dealer-rejected

# n8n — "cumple criterios, agenda tu llamada" (embudo de precios ocultos, 2026-09-02): dispara el
# email con el enlace de auto-agenda cuando el admin marca una solicitud market_directo como
# cualificada (markQualifiedAwaitingCall en admin/altas-showroom/actions.ts). Workflow versionado
# en n8n-workflows/wf-dealer-qualified.json.
N8N_WEBHOOK_DEALER_QUALIFIED=https://tu-n8n.com/webhook/blm/dealer-qualified

# Enlace de auto-agenda (Google Calendar) para la llamada de admisión. Mientras no esté conectado,
# el email de "cumples criterios" se envía igualmente y pide responder por correo para proponer
# horario — no bloquea, solo degrada la experiencia hasta que se configure.
SHOWROOM_ADMISSION_CALL_BOOKING_URL=

# n8n — formulario público /contacto (app/api/contact/route.ts). Mismo esquema de firma que
# N8N_WEBHOOK_DEALER_SIGNUP (HMAC + cabeceras x-blacklabel-*). Workflow versionado en
# n8n-workflows/wf-contact-form.json.
N8N_WEBHOOK_CONTACT_FORM=https://tu-n8n.com/webhook/blm/contact
N8N_WEBHOOK_CONTACT_FORM_SECRET=

# n8n — webhook de finalización de onboarding de fundador (app/api/onboarding/[token]/complete).
# Auditoría de seguridad 2026-09-02 (P0.6): antes caía a una URL hardcodeada sin firma si faltaba
# esta variable; ahora la ruta falla cerrado (500) sin URL + secreto — CONFIGURAR EN VERCEL ANTES
# DE DESPLEGAR este fix, o el último paso del onboarding de un fundador real dejará de funcionar.
N8N_WEBHOOK_FUNDADOR_ONBOARDING=https://tu-n8n.com/webhook/bsa/fundador-onboarding
N8N_WEBHOOK_FUNDADOR_ONBOARDING_SECRET=

# n8n — webhook único de eventos de negocio (lead.created, custom_request.created,
# search_alert.created, vehicle.submitted_for_review / approved / rejected).
# Si está vacío, los eventos se guardan igualmente en la tabla integration_events (outbox).
N8N_WEBHOOK_URL=
# Secreto opcional enviado como cabecera X-Webhook-Secret para validar el origen en n8n
N8N_WEBHOOK_SECRET=

# n8n — API de gestión (no webhooks): usada por lib/integrations/n8n-assistant-provisioning.ts
# para clonar/activar/desactivar el workflow de asistente IA dedicado de cada dealer Elite.
# Header X-N8N-API-KEY. Base URL opcional (por defecto la instancia de producción de la agencia).
N8N_API_KEY=
N8N_API_BASE_URL=
N8N_ASSISTANT_WEBHOOK_BASE_URL=

# Vehiculos a la carta — genera secretos aleatorios: openssl rand -hex 32
# CUSTOM_REQUESTS_INTERNAL_TOKEN se usa entre n8n y la API interna para registrar emails enviados.
CUSTOM_REQUESTS_INTERNAL_TOKEN=
# CUSTOM_REQUESTS_RATE_LIMIT_SALT se usa para hashear IPs antes de guardarlas en metadata.
CUSTOM_REQUESTS_RATE_LIMIT_SALT=

# Email (Resend o Mailgun)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@blacklabelmarket.es

# Google Calendar (Fase A, agendamiento Elite) — proyecto de Google Cloud + pantalla de
# consentimiento OAuth propios del dueño del producto, no se pueden generar aquí.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Firma el `state` del flujo OAuth: genera un secreto aleatorio, openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=
# Cifra access/refresh tokens en BD (AES-256-GCM, lib/google-calendar.ts): 32 bytes en hex,
# openssl rand -hex 32. Sin esta clave, la conexión con Google Calendar no funciona.
GOOGLE_TOKEN_ENCRYPTION_KEY=
