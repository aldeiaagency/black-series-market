        "jsCode": "const d = $input.first().json;\nconst MAIL_FROM   = $env.MAIL_FROM   || 'Black Label Market <no-reply@blacklabelmarket.es>';\nconst ADMIN_EMAIL = $env.ADMIN_EMAIL || 'aldeiaceo@gmail.com';\nconst MARKET_URL  = $env.MARKET_URL  || 'https://blacklabelmarket.es';\n\nconst notesHtml = d.admin_notes\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\\n/g, '<br>');\n\nconst emailHtml = `<p>Hola ${d.full_name},</p>\n<p>Hemos revisado la solicitud de alta de <strong>${d.dealer_name}</strong> en Black Label Market y nos gustar�a obtener alguna informaci�n adicional antes de continuar con el proceso.</p>\n<blockquote style=\"border-left:3px solid #c9a227;padding-left:12px;margin:16px 0;color:#555\">${notesHtml}</blockquote>\n<p>Por favor, responde a este email con la informaci�n solicitada o, si lo prefieres, puedes contactarnos directamente.</p>\n<p>Quedamos a tu disposici�n.<br>El equipo de Black Label Market</p>`;\n\nreturn [{\n  json: {\n    ...d,\n    emailPayload: {\n      from: MAIL_FROM, to: [d.email],\n      subject: `Solicitud de alta - necesitamos informaci�n adicional`,\n      html: emailHtml\n    },\n    slackText: `*?? Solicitud de m�s info enviada*\\n\\n*Showroom:* ${d.dealer_name}\\n*Contacto:* ${d.full_name} (${d.email})${d.admin_url ? '\\n' + d.admin_url : ''}`\n  }\n}];"
